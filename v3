        .img-miniatura { width: 30px; height: 30px; border-radius: 6px; background: rgba(255,255,255,0.08); display: inline-block; } /* Miniatura */

        /* =========================================================
           ZONA 9: LAYOUT DEL DASHBOARD (MÓDULOS 01, 04, 05)
           ========================================================= */
        .dash-layout { display: grid; grid-template-columns: 2fr 1fr; gap: 20px; width: 100%; margin-bottom: 25px; } /* Layout 2 columnas 2:1 */
        .dash-panel-lateral { background: var(--panel-bg); border: 1px solid var(--borde-panel); border-radius: 12px; padding: 20px; display: flex; flex-direction: column; justify-content: center; box-shadow: 0 10px 30px rgba(0,0,0,0.4); } /* Panel lateral */
        .meta-dia { margin-bottom: 15px; } /* Bloque de meta (barra) */
        .meta-dia:last-child { margin-bottom: 0; } /* Quita margen al último */
        .meta-header { display: flex; justify-content: space-between; font-size: 11px; color: var(--texto-gris); margin-bottom: 5px; font-weight: 600; } /* Cabecera de la barra */
        
        .barra-progreso-bg { width: 100%; height: 7px; background: rgba(255,255,255,0.08); border-radius: 10px; overflow: hidden; margin-bottom: 3px; } /* Fondo de la barra */
        .barra-progreso-fill { height: 100%; background: linear-gradient(90deg, #d49555, #e5a963); border-radius: 10px; transition: width 1s; } /* Relleno animado */

        .caja-historial { background: var(--panel-bg); border: 1px solid var(--borde-panel); border-radius: 12px; padding: 20px; width: 100%; box-shadow: 0 10px 30px rgba(0,0,0,0.4); } /* Caja de historial */
        .filtros-movimientos { display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 1px solid var(--borde-panel); padding-bottom: 15px; } /* Fila de filtros */
        .btn-filtro-mov { background: rgba(255,255,255,0.04); border: 1px solid var(--borde-panel); color: var(--texto-gris); padding: 6px 12px; border-radius: 6px; font-size: 11px; cursor: pointer; transition: 0.2s; } /* Botón filtro */
        .btn-filtro-mov.activo { background: rgba(229, 169, 99, 0.2); color: var(--dorado); border-color: var(--dorado); font-weight: bold; } /* Filtro activo */

        .lista-movimientos { display: flex; flex-direction: column; } /* Lista de movimientos */
        .item-movimiento { display: flex; justify-content: space-between; align-items: center; padding: 14px 10px; border-bottom: 1px solid rgba(255,255,255,0.04); transition: 0.2s; } /* Cada movimiento */
        .item-movimiento:hover { background: rgba(255,255,255,0.03); } /* Hover */

        .mov-izq { display: flex; align-items: center; gap: 15px; } /* Lado izquierdo del movimiento */
        .mov-icono { width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.06); display: flex; align-items: center; justify-content: center; font-size: 18px; border: 1px solid var(--borde-panel); } /* Icono del movimiento */
        .mov-textos h4 { font-size: 13px; margin-bottom: 3px; } /* Título del movimiento */
        .mov-textos p { font-size: 10px; color: var(--texto-gris); } /* Detalle */

        .mov-der { text-align: right; } /* Lado derecho alineado a la derecha */
        .mov-cantidad { font-size: 14px; font-weight: bold; margin-bottom: 2px; } /* Cantidad */
        .mov-entrada { color: var(--color-prov); } /* Verde para entradas */
        .mov-salida { color: var(--color-rojo); } /* Rojo para salidas */
        .badge-completado { background: rgba(16, 185, 129, 0.12); color: var(--color-prov); padding: 4px 10px; border-radius: 20px; font-size: 9px; font-weight: bold; border: 1px solid rgba(16, 185, 129, 0.2); } /* Badge de estado */

        .banner-produccion { background: linear-gradient(135deg, rgba(147, 51, 234, 0.25) 0%, rgba(26, 17, 12, 0.95) 100%); border: 1px solid rgba(147, 51, 234, 0.4); border-radius: 12px; padding: 25px; margin-bottom: 25px; box-shadow: 0 10px 25px rgba(0,0,0,0.3); } /* Banner de producción */
        .banner-produccion h3 { font-size: 18px; color: #c084fc; margin-bottom: 5px; } /* Título del banner */
        
        .grid-produccion { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 15px; } /* Grid de tarjetas de producción */
        .card-prod-activa { background: var(--panel-bg); border: 1px solid var(--borde-panel); border-radius: 12px; padding: 18px; position: relative; overflow: hidden; box-shadow: 0 8px 20px rgba(0,0,0,0.3); } /* Tarjeta producción activa */
        .card-prod-activa::before { content: ""; position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: var(--dorado); } /* Barra dorada lateral */
        
        .prod-header { display: flex; justify-content: space-between; margin-bottom: 12px; } /* Cabecera de la tarjeta */
        .prod-header h4 { font-size: 14px; font-weight: 600; } /* Nombre producto */
        .prod-header span { font-size: 10px; color: var(--texto-gris); } /* Subtítulo */
        
        .prod-detalles { background: rgba(0,0,0,0.25); border-radius: 8px; padding: 12px; margin-bottom: 15px; font-size: 11px; color: var(--texto-gris); border: 1px solid rgba(255,255,255,0.02); } /* Bloque de detalles */
        .prod-detalles div { display: flex; justify-content: space-between; margin-bottom: 6px; } /* Fila de detalle */
        .prod-detalles div:last-child { margin-bottom: 0; } /* Sin margen en la última */
        
        .trabajando { animation: latidoTrabajo 2s infinite ease-in-out; } /* Clase que aplica la animación de latido */
        .contenedor-dashboard { width: 100%; max-width: 1050px; } /* Contenedor de las pantallas del dashboard */

        /* =========================================================
           ZONA 10: ⭐ DASHBOARD MEJORADO (NUEVOS ESTILOS) ⭐
           ========================================================= */

        /* --- Banner de bienvenida --- */
        .dash-bienvenida {                         /* Bloque superior de saludo */
            display: flex;                         /* Flex horizontal */
            justify-content: space-between;        /* Separa texto y botones */
            align-items: center;                   /* Centrado vertical */
            background: linear-gradient(135deg, rgba(229,169,99,0.15) 0%, rgba(229,169,99,0.02) 100%); /* Degradado dorado sutil */
            border: 1px solid var(--dorado);       /* Borde dorado */
            border-radius: 16px;                   /* Esquinas redondeadas */
            padding: 25px 30px;                    /* Espacio interno */
            margin-bottom: 25px;                   /* Separación inferior */
            flex-wrap: wrap;                       /* Permite bajar si no hay espacio */
            gap: 15px;                             /* Separación entre elementos */
        }
        .dash-bienvenida h2 { font-size: 22px; margin-bottom: 5px; } /* Saludo grande */
        .dash-bienvenida p { font-size: 12px; color: var(--texto-gris); } /* Subtítulo gris */

        /* --- Botones de acción rápida --- */
        .dash-acciones-rapidas { display: flex; gap: 10px; } /* Fila de botones */
        .btn-rapido { padding: 10px 18px; border-radius: 8px; font-size: 12px; font-weight: bold; cursor: pointer; border: none; transition: 0.2s; } /* Estilo base del botón rápido */
        .btn-rapido.primary { background: var(--dorado); color: black; } /* Variante principal (dorado) */
        .btn-rapido.secondary { background: rgba(255,255,255,0.08); color: white; border: 1px solid var(--borde-panel); } /* Variante secundaria (gris) */
        .btn-rapido:hover { transform: translateY(-2px); filter: brightness(1.1); } /* Hover */

        /* --- Grid de KPIs (tarjetas de indicadores) --- */
        .dash-kpis {                              /* Grid de 4 KPIs */
            display: grid;                        /* Uso de Grid */
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); /* Columnas auto-responsivas */
            gap: 15px;                            /* Espacio entre tarjetas */
            margin-bottom: 25px;                  /* Separación inferior */
        }
        .kpi-card {                               /* Tarjeta individual KPI */
            background: var(--panel-bg);          /* Fondo translúcido */
            border: 1px solid var(--borde-panel); /* Borde sutil */
            border-radius: 12px;                  /* Esquinas redondeadas */
            padding: 20px;                        /* Espacio interno */
            display: flex;                        /* Flex horizontal */
            gap: 15px;                            /* Espacio icono-info */
            align-items: flex-start;              /* Alinea arriba */
            transition: 0.2s;                     /* Transición */
            box-shadow: 0 8px 20px rgba(0,0,0,0.3); /* Sombra */
        }
        .kpi-card:hover { transform: translateY(-3px); border-color: rgba(229,169,99,0.4); } /* Hover */
        .kpi-icon {                               /* Círculo con icono del KPI */
            width: 45px; height: 45px;            /* Tamaño fijo */
            border-radius: 10px;                  /* Esquinas redondeadas */
            display: flex; align-items: center; justify-content: center; /* Centrado */
            font-size: 20px;                      /* Tamaño emoji */
            flex-shrink: 0;                       /* No se encoge */
        }
        .kpi-info { flex-grow: 1; }              /* La info ocupa el resto */
        .kpi-info p { font-size: 10px; color: var(--texto-gris); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px; } /* Etiqueta del KPI */
        .kpi-info h3 { font-size: 26px; font-weight: 700; margin-bottom: 4px; } /* Número grande */
        .kpi-trend { font-size: 10px; font-weight: bold; } /* Tendencia (↑ ↓) */
        .kpi-trend.up { color: #10b981; }        /* Positiva: verde */
        .kpi-trend.down { color: #f43f5e; }      /* Negativa: rojo */
        .kpi-trend.neutral { color: var(--texto-gris); } /* Neutral: gris */

        /* --- Tarjeta genérica reutilizable --- */
        .dash-card {                              /* Bloque blanco de sección */
            background: var(--panel-bg);          /* Fondo translúcido */
            border: 1px solid var(--borde-panel); /* Borde sutil */
            border-radius: 12px;                  /* Esquinas redondeadas */
            padding: 20px;                        /* Espacio interno */
            margin-bottom: 20px;                  /* Separación inferior */
            box-shadow: 0 8px 20px rgba(0,0,0,0.3); /* Sombra */
        }
        .dash-card h3 { font-size: 14px; margin-bottom: 15px; color: var(--dorado); } /* Título de la sección */

        /* --- Mini gráfico de barras (semanal) --- */
        .mini-chart {                             /* Contenedor del gráfico */
            display: flex;                        /* Flex horizontal */
            align-items: flex-end;                /* Alinea barras abajo */
            justify-content: space-between;       /* Espacio entre columnas */
            height: 120px;                        /* Altura del gráfico */
            gap: 8px;                             /* Separación entre barras */
            padding-top: 10px;                    /* Espacio arriba */
        }
        .chart-col {                              /* Cada columna (barra + label) */
            flex: 1;                              /* Todas iguales */
            display: flex;                        /* Flex vertical */
            flex-direction: column;               /* Barra arriba, label abajo */
            align-items: center;                  /* Centrado horizontal */
            gap: 5px;                             /* Separación barra-label */
            height: 100%;                         /* Altura completa */
            justify-content: flex-end;            /* Empuja hacia abajo */
        }
        .chart-bar {                              /* Barra del gráfico */
            width: 100%;                          /* Ocupa toda la columna */
            background: linear-gradient(to top, #d49555, #e5a963); /* Degradado dorado vertical */
            border-radius: 4px 4px 0 0;           /* Redondea arriba */
            min-height: 10px;                     /* Mínimo visible */
            transition: 0.3s;                     /* Transición de altura */
        }
        .chart-bar:hover { filter: brightness(1.2); } /* Hover brillante */
        .chart-label { font-size: 9px; color: var(--texto-gris); } /* Etiqueta del día */

        /* --- Lista Top productos --- */
        .top-lista { display: flex; flex-direction: column; gap: 10px; } /* Lista vertical */
        .top-item { display: flex; align-items: center; gap: 12px; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.04); } /* Fila del top */
        .top-item:last-child { border-bottom: none; } /* Último sin borde */
        .top-num { width: 22px; height: 22px; border-radius: 50%; background: rgba(229,169,99,0.2); color: var(--dorado); display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: bold; } /* Número del top */
        .top-nombre { flex-grow: 1; font-size: 12px; } /* Nombre del producto */
        .top-cant { font-size: 11px; font-weight: bold; color: white; } /* Cantidad vendida */

        /* --- Alertas críticas --- */
        .alerta-item { display: flex; gap: 10px; padding: 12px; border-radius: 8px; margin-bottom: 10px; border-left: 3px solid; } /* Alerta base */
        .alerta-item.rojo { background: rgba(244,63,94,0.08); border-color: var(--color-rojo); } /* Alerta roja */
        .alerta-item.amarillo { background: rgba(245,158,11,0.08); border-color: var(--color-amarillo); } /* Alerta amarilla */
        .alerta-item h4 { font-size: 11px; margin-bottom: 3px; } /* Título de la alerta */
        .alerta-item p { font-size: 9px; color: var(--texto-gris); } /* Detalle de la alerta */

        /* --- Timeline de actividad --- */
        .timeline { display: flex; flex-direction: column; gap: 12px; position: relative; padding-left: 15px; } /* Contenedor del timeline */
        .timeline::before { content: ''; position: absolute; left: 4px; top: 5px; bottom: 5px; width: 2px; background: rgba(229,169,99,0.2); } /* Línea vertical de conexión */
        .tl-item { position: relative; padding-left: 15px; } /* Cada evento */
        .tl-item::before { content: ''; position: absolute; left: -15px; top: 5px; width: 8px; height: 8px; border-radius: 50%; background: var(--dorado); border: 2px solid var(--fondo-oscuro); } /* Punto dorado del evento */
        .tl-item h4 { font-size: 11px; margin-bottom: 2px; } /* Título del evento */
        .tl-item p { font-size: 9px; color: var(--texto-gris); } /* Detalle del evento */

        /* --- Estado del obrador (semáforo) --- */
        .estado-fila { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.04); font-size: 11px; } /* Fila de estado */
        .estado-fila:last-child { border-bottom: none; } /* Última sin borde */
        .semaforo { display: flex; align-items: center; gap: 6px; font-size: 10px; } /* Contenedor semáforo */
        .semaforo::before { content: ''; width: 8px; height: 8px; border-radius: 50%; } /* Círculo del semáforo */
        .semaforo.verde::before { background: #10b981; box-shadow: 0 0 8px #10b981; } /* Verde */
        .semaforo.amarillo::before { background: #f59e0b; box-shadow: 0 0 8px #f59e0b; } /* Amarillo */
        .semaforo.rojo::before { background: #f43f5e; box-shadow: 0 0 8px #f43f5e; } /* Rojo */
    </style> 
</head> 
