    <script> 
        // ──────────────────────────────────────────────────────────
        // VARIABLES DEL HISTORIAL DE NAVEGACIÓN
        // ──────────────────────────────────────────────────────────
        let historialPantallas = ['pantalla-inicio'];  // Array con la pantalla actual como inicio
        let posicionHistorial = 0;                     // Índice de la pantalla actual dentro del array
        let usandoFlechasNav = false;                  // Bandera para saber si navegamos con flechas

        // ──────────────────────────────────────────────────────────
        // FUNCIÓN: cambiarPantalla
        // Recibe el id de la pantalla a mostrar y la activa.
        // ──────────────────────────────────────────────────────────
        function cambiarPantalla(idPantallaDestino) { 
            let todasLasPantallas = document.querySelectorAll('.pantalla'); // Selecciona TODAS las pantallas
            todasLasPantallas.forEach(function(pantalla) {                  // Recorre cada una
                pantalla.classList.remove('activa');                        // Le quita la clase 'activa'
            }); 

            document.getElementById(idPantallaDestino).classList.add('activa'); // Activa solo la destino

            document.getElementById('area-scroll').scrollTo(0, 0);          // Sube el scroll al inicio

            if (!usandoFlechasNav) {                                        // Si NO venimos de las flechas
                if (posicionHistorial < historialPantallas.length - 1) {    // Si hay pantallas adelante en el historial
                    historialPantallas = historialPantallas.slice(0, posicionHistorial + 1); // Las borra
                }
                if (historialPantallas[historialPantallas.length - 1] !== idPantallaDestino) { // Si la última no es la destino
                    historialPantallas.push(idPantallaDestino);              // La agrega al historial
                    posicionHistorial++;                                     // Avanza el índice
                }
            }
            usandoFlechasNav = false;                                        // Reinicia la bandera
        } 

        // ──────────────────────────────────────────────────────────
        // FUNCIÓN: retrocederHistorial (botón ←)
        // ──────────────────────────────────────────────────────────
        function retrocederHistorial() {
            if (posicionHistorial > 0) {                                     // Si hay pantalla anterior
                posicionHistorial--;                                         // Retrocede el índice
                usandoFlechasNav = true;                                     // Marca que navegamos con flechas
                cambiarPantalla(historialPantallas[posicionHistorial]);      // Carga esa pantalla
            }
        }

        // ──────────────────────────────────────────────────────────
        // FUNCIÓN: avanzarHistorial (botón →)
        // ──────────────────────────────────────────────────────────
        function avanzarHistorial() {
            if (posicionHistorial < historialPantallas.length - 1) {         // Si hay pantalla siguiente
                posicionHistorial++;                                         // Avanza el índice
                usandoFlechasNav = true;                                     // Marca navegación por flechas
                cambiarPantalla(historialPantallas[posicionHistorial]);      // Carga la pantalla
            }
        }

        // ──────────────────────────────────────────────────────────
        // FUNCIÓN: simularIngreso
        // Detecta el rol según el correo y navega a su panel.
        // ──────────────────────────────────────────────────────────
        function simularIngreso(tipoDeFormulario) {
            document.getElementById('barra-navegacion').style.display = 'flex'; // Muestra la barra superior

            let correoIngresado = tipoDeFormulario === 'general'             // Si es login general
                ? document.getElementById('correo-general').value.toLowerCase() // Toma correo general (minúsculas)
                : document.getElementById('correo-prov').value.toLowerCase();   // Si no, correo proveedor

            if (correoIngresado.includes("admin")) {                         // ¿Contiene "admin"?
                cambiarPantalla('pantalla-dashboard-admin');                 // → Dashboard administrador
            } else if (correoIngresado.includes("almacen")) {                // ¿Contiene "almacen"?
                cambiarPantalla('pantalla-inventario');                      // → Inventario
            } else if (correoIngresado.includes("produccion")) {             // ¿Contiene "produccion"?
                cambiarPantalla('pantalla-produccion');                      // → Producción
            } else if (correoIngresado.includes("proveedor")) {              // ¿Contiene "proveedor"?
                alert("⚠️ El panel del proveedor estará disponible pronto.");// Aviso
                cambiarPantalla('pantalla-mantenimiento');                   // → Mantenimiento
            } else {                                                         // Cualquier otro correo
                alert("⚠️ Esta cuenta no tiene un panel asignado.");         // Aviso
                cambiarPantalla('pantalla-mantenimiento');                   // → Mantenimiento
            }
        }

        // ──────────────────────────────────────────────────────────
        // FUNCIÓN: cerrarSesion (botón ×)
        // ──────────────────────────────────────────────────────────
        function cerrarSesion() {
            document.getElementById('barra-navegacion').style.display = 'none'; // Oculta la barra superior
            historialPantallas = ['pantalla-inicio'];                            // Reinicia el historial
            posicionHistorial = 0;                                               // Reinicia el índice
            cambiarPantalla('pantalla-inicio');                                  // Vuelve al inicio
        }

        // ──────────────────────────────────────────────────────────
        // FUNCIONES DEL MENÚ ☰ (modal constelación)
        // ──────────────────────────────────────────────────────────
        function abrirMenu() {                                                   // Abre el modal
            document.getElementById('modal-menu-nav').classList.add('abierto'); // Añade clase .abierto
        }
        function cerrarMenu() {                                                  // Cierra el modal
            document.getElementById('modal-menu-nav').classList.remove('abierto'); // Quita la clase
        }

        function navegarDesdeMenu(idPantallaDestino) {                           // Navega desde un módulo del menú
            cambiarPantalla(idPantallaDestino);                                  // Cambia la pantalla
            cerrarMenu();                                                        // Y cierra el modal
        }

        // ──────────────────────────────────────────────────────────
        // FUNCIÓN: guardarProducto
        // ──────────────────────────────────────────────────────────
        function guardarProducto() {
            alert("¡Producto guardado exitosamente en el catálogo!");            // Muestra confirmación
            cambiarPantalla('pantalla-productos-admin');                         // Vuelve al catálogo
        }

        // ──────────────────────────────────────────────────────────
        // FUNCIÓN: avisoFaltaProgramar (aviso genérico)
        // ──────────────────────────────────────────────────────────
        function avisoFaltaProgramar() {
            alert("⚠️ Falta programar esta función próximamente.");             // Muestra el aviso
        }

        // ──────────────────────────────────────────────────────────
        // FUNCIÓN: previsualizarFoto
        // Muestra la foto elegida en el formulario de producto.
        // ──────────────────────────────────────────────────────────
        function previsualizarFoto(inputElement) {
            if (inputElement.files && inputElement.files[0]) {                   // Si hay archivo seleccionado
                let lector = new FileReader();                                    // Crear lector de archivos
                lector.onload = function(evento) {                                // Callback al terminar de leer
                    let caja = document.getElementById('area-foto');              // Referencia a la caja
                    let texto = document.getElementById('texto-foto');            // Referencia al texto
                    caja.style.backgroundImage = "url('" + evento.target.result + "')"; // Pone la imagen de fondo
                    caja.style.backgroundSize = "cover";                          // Ajusta el tamaño
                    caja.style.backgroundPosition = "center";                     // Centra la imagen
                    texto.style.display = "none";                                 // Oculta el texto placeholder
                };
                lector.readAsDataURL(inputElement.files[0]);                      // Lee el archivo como data URL
            }
        }

        // ──────────────────────────────────────────────────────────
        // FUNCIÓN: llenarDatos (autocompleta cuentas demo)
        // ──────────────────────────────────────────────────────────
        function llenarDatos(correo, clave, idCampoCorreo, idCampoClave) {
            document.getElementById(idCampoCorreo).value = correo;               // Rellena el correo
            document.getElementById(idCampoClave).value = clave;                 // Rellena la contraseña
            document.getElementById(idCampoClave).focus();                       // Enfoca el campo clave
        }
    </script> 
