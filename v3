<!DOCTYPE html> <!-- Declara el tipo de documento como HTML5 -->
<html lang="es"> <!-- Etiqueta raíz del documento, idioma español -->
<head> <!-- Inicio de la cabecera (configuraciones invisibles) -->
    <meta charset="UTF-8"> <!-- Codificación UTF-8 para tildes y ñ -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!-- Adapta la web a móviles -->
    <title>Villa de Guaduas - Sistema Completo V6</title> <!-- Título de la pestaña -->
    
    <!-- Fuente externa 'Inter' de Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
    
    <style> 
        /* =========================================================
           ZONA 1: VARIABLES GLOBALES DE COLORES (PALETA)
           ========================================================= */
        :root { /* Selector de nivel raíz, aquí se guardan las variables CSS */
            --fondo-oscuro: #21110a;              /* Color café oscuro de fondo base */
            --dorado: #e5a963;                    /* Dorado principal de acentos */
            --panel-bg: rgba(26, 17, 12, 0.92);   /* Fondo semitransparente de paneles */
            --borde-panel: rgba(255, 255, 255, 0.12); /* Gris claro para bordes sutiles */
            --texto-blanco: #ffffff;              /* Blanco puro para títulos */
            --texto-gris: #b8a69a;                /* Gris cálido para textos secundarios */
            --hover-boton: rgba(229, 169, 99, 0.2); /* Dorado transparente para hover */
            --color-admin: #e5a963;               /* Color rol Administrador (dorado) */
            --color-almacen: #9333ea;             /* Color rol Almacén (morado) */
            --color-prod: #ec4899;                /* Color rol Producción (fucsia) */
            --color-prov: #10b981;                /* Color rol Proveedor / éxito (verde) */
            --color-rojo: #f43f5e;                /* Rojo coral para alertas críticas */
            --color-amarillo: #f59e0b;            /* Amarillo ámbar para avisos medios */
        } 

        /* =========================================================
           ZONA 2: RESET GLOBAL
           ========================================================= */
        * {                                       /* Aplica a TODOS los elementos */
            margin: 0;                            /* Quita margen por defecto */
            padding: 0;                           /* Quita padding por defecto */
            box-sizing: border-box;               /* Incluye border en el width/height */
            font-family: 'Inter', sans-serif;     /* Aplica la fuente Inter a todo */
        } 

        body {                                    /* Estilos generales del cuerpo */
            background-color: var(--fondo-oscuro); /* Fondo café oscuro base */
            background-image: radial-gradient(circle at 50% 10%, #4a2818 0%, #170a04 100%); /* Gradiente radial decorativo */
            color: var(--texto-blanco);           /* Texto blanco por defecto */
            height: 100vh;                        /* Ocupa el 100% de la ventana */
            display: flex;                        /* Usa flexbox para el layout */
            flex-direction: column;               /* Dirección vertical (barra arriba, contenido abajo) */
            overflow: hidden;                     /* Oculta scroll del body (lo maneja el contenedor interno) */
        } 

        /* =========================================================
           ZONA 3: SCROLLBARS PERSONALIZADOS (webkit)
           ========================================================= */
        ::-webkit-scrollbar { width: 8px; height: 8px; } /* Ancho del scroll vertical y horizontal */
        ::-webkit-scrollbar-track { background: var(--fondo-oscuro); border-radius: 10px; } /* Fondo del riel */
        ::-webkit-scrollbar-thumb { background: rgba(229, 169, 99, 0.3); border-radius: 10px; } /* Pulgar dorado semiopaco */
        ::-webkit-scrollbar-thumb:hover { background: var(--dorado); } /* Al pasar el mouse, dorado pleno */

        /* =========================================================
           ZONA 4: BARRA SUPERIOR DE NAVEGACIÓN
           ========================================================= */
        .barra-superior {                         /* Contenedor principal de la barra */
            width: 100%;                          /* Ocupa todo el ancho */
            background: var(--panel-bg);          /* Fondo semitransparente */
            border-bottom: 1px solid var(--borde-panel); /* Línea divisoria inferior */
            padding: 12px 30px;                   /* Espacio interno */
            display: flex;                        /* Flexbox para distribuir hijos */
            justify-content: space-between;       /* Separa izquierda/derecha */
            align-items: center;                  /* Centra verticalmente */
            z-index: 100;                         /* Capa superior */
            box-shadow: 0 4px 20px rgba(0,0,0,0.4); /* Sombra inferior */
        } 
        
        .btn-menu-abrir {                         /* Botón ☰ Menú */
            background: rgba(255,255,255,0.06);   /* Fondo blanco translúcido */
            border: 1px solid var(--borde-panel); /* Borde sutil */
            color: var(--dorado);                 /* Texto dorado */
            padding: 8px 16px;                    /* Espacio interno */
            border-radius: 8px;                   /* Esquinas redondeadas */
            cursor: pointer;                      /* Cursor tipo mano */
            font-weight: bold;                    /* Texto en negrita */
            font-size: 12px;                      /* Tamaño pequeño */
            margin-right: 15px;                   /* Separación derecha */
            transition: 0.2s;                     /* Transición suave */
        }
        .btn-menu-abrir:hover { background: rgba(229, 169, 99, 0.15); border-color: var(--dorado); } /* Estado hover */

        /* Flechas de navegación ← → */
        .flecha-nav {
            background: rgba(255,255,255,0.06);   /* Fondo translúcido */
            border: 1px solid var(--borde-panel); /* Borde sutil */
            color: white;                         /* Texto blanco */
            width: 34px;                          /* Ancho fijo */
            height: 34px;                         /* Alto fijo */
            border-radius: 8px;                   /* Esquinas redondeadas */
            cursor: pointer;                      /* Cursor mano */
            font-weight: bold;                    /* Negrita */
            font-size: 15px;                      /* Tamaño flecha */
            display: flex;                        /* Flex para centrar */
            align-items: center;                  /* Centrado vertical */
            justify-content: center;              /* Centrado horizontal */
            transition: 0.2s;                     /* Transición */
        }
        .flecha-nav:hover { background: rgba(255,255,255,0.12); border-color: var(--dorado); color: var(--dorado); } /* Hover dorado */

        /* =========================================================
           ZONA 5: MODAL DEL MENÚ (LA "CONSTELACIÓN" DE MÓDULOS)
           ========================================================= */
        .modal-menu-fondo {                       /* Fondo oscuro que cubre toda la pantalla */
            position: fixed;                      /* Fijo respecto al viewport */
            top: 0; left: 0;                      /* Pegado a la esquina superior izquierda */
            width: 100vw;                         /* Ancho total de la ventana */
            height: 100vh;                        /* Alto total de la ventana */
            background: rgba(0,0,0,0.85);         /* Negro semitransparente */
            display: none;                        /* Oculto por defecto */
            justify-content: center;              /* Centra contenido horizontal */
            align-items: center;                  /* Centra contenido vertical */
            z-index: 999;                         /* Muy por encima del resto */
            backdrop-filter: blur(5px);           /* Difumina el fondo detrás */
        }
        .modal-menu-fondo.abierto { display: flex; } /* Cuando tiene la clase .abierto, se muestra */

        .caja-constelacion {                      /* Caja del menú de módulos */
            background: linear-gradient(135deg, #321b10, #170a04); /* Gradiente café */
            border: 1px solid var(--dorado);      /* Borde dorado */
            border-radius: 16px;                  /* Esquinas redondeadas */
            padding: 40px;                        /* Espacio interno amplio */
            width: 95%;                           /* 95% del ancho disponible */
            max-width: 900px;                     /* Máximo 900px */
            text-align: center;                   /* Texto centrado */
            position: relative;                   /* Para posicionar la X absoluta */
            max-height: 90vh;                     /* No más del 90% del alto de pantalla */
            overflow-y: auto;                     /* Scroll vertical si hace falta */
            box-shadow: 0 20px 40px rgba(0,0,0,0.8); /* Sombra profunda */
        }
        
        .grid-constelacion {                      /* Grid de módulos (los circulitos) */
            display: grid;                        /* Uso de CSS Grid */
            grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); /* Columnas auto-responsivas */
            gap: 18px;                            /* Espacio entre celdas */
            margin-top: 25px;                     /* Separación superior */
        }
        
        .item-menu-circular {                     /* Cada ítem del menú (icono + texto) */
            display: flex;                        /* Flexbox vertical */
            flex-direction: column;               /* Icono arriba, texto abajo */
            align-items: center;                  /* Centrado horizontal */
            cursor: pointer;                      /* Cursor mano */
            transition: 0.2s;                     /* Transición */
        }
        .item-menu-circular:hover { transform: scale(1.08); } /* Agranda al pasar mouse */
        
        .circulo-icono {                          /* Círculo con el icono */
            width: 55px;                          /* Ancho fijo */
            height: 55px;                         /* Alto fijo */
            border-radius: 50%;                   /* Forma circular */
            background: rgba(255,255,255,0.04);   /* Fondo blanco muy tenue */
            border: 1px solid var(--borde-panel); /* Borde sutil */
            display: flex;                        /* Flex para centrar el emoji */
            align-items: center;                  /* Centrado vertical */
            justify-content: center;              /* Centrado horizontal */
            font-size: 24px;                      /* Tamaño del emoji */
            margin-bottom: 8px;                   /* Separación con el texto */
            box-shadow: inset 0 2px 5px rgba(255,255,255,0.05); /* Sombra interior */
            transition: 0.2s;                     /* Transición */
        }
        .item-menu-circular:hover .circulo-icono { background: rgba(229, 169, 99, 0.15); border-color: var(--dorado); } /* Hover dorado */

        /* =========================================================
           ZONA 6: MOTOR DE PANTALLAS (CONTENEDOR Y ANIMACIONES)
           ========================================================= */
        .contenedor-principal {                   /* Área de scroll de todas las pantallas */
            flex-grow: 1;                         /* Crece para ocupar el espacio libre */
            overflow-y: auto;                     /* Scroll vertical interno */
            display: flex;                        /* Flex vertical */
            flex-direction: column;               /* Hijos en columna */
            align-items: center;                  /* Centrado horizontal */
            padding: 35px 20px;                   /* Espacio interno */
        }

        .pantalla {                               /* Cada pantalla individual */
            display: none;                        /* Oculta por defecto */
            width: 100%;                          /* Ancho completo del contenedor */
            max-width: 1200px;                    /* Máximo 1200px */
            animation: aparecer 0.35s ease-out forwards; /* Animación de entrada */
            flex-direction: column;               /* Flex vertical */
            align-items: center;                  /* Centrado horizontal */
        } 
        .pantalla.activa { display: flex; } /* Solo la pantalla .activa se muestra */

        @keyframes aparecer {                     /* Animación de aparición */
            from { opacity: 0; transform: translateY(8px); } /* Inicio: invisible y desplazado abajo */
            to { opacity: 1; transform: translateY(0); }     /* Final: visible y en posición */
        } 
        @keyframes latidoTrabajo {                /* Animación de "latido" para "trabajando" */
            0% { opacity: 1; transform: scale(1); }       /* Estado normal */
            50% { opacity: 0.75; transform: scale(0.97); } /* Aplastado y semitransparente */
            100% { opacity: 1; transform: scale(1); }      /* Vuelve a la normalidad */
        }

        /* =========================================================
           ZONA 7: PANTALLA DE INICIO Y LOGIN
           ========================================================= */
        .hero-inicio {                            /* Bloque central de bienvenida */
            text-align: center;                   /* Texto centrado */
            margin-bottom: 40px;                  /* Separación inferior */
            margin-top: 2vh;                      /* Pequeño margen superior */
        } 
        .hero-inicio h1 { font-size: 42px; margin-bottom: 10px; font-weight: 700; } /* Título grande */
        .hero-inicio h1 span { color: var(--dorado); } /* Parte dorada del título */
        .hero-inicio p { color: var(--texto-gris); font-size: 14px; margin-bottom: 30px; } /* Párrafo gris */
        
        .stats { display: flex; justify-content: center; gap: 50px; } /* Fila de estadísticas principales */
        .stat-item { text-align: center; }                            /* Cada estadística */
        .stat-item h3 { font-size: 24px; color: var(--dorado); }      /* Número grande dorado */
        .stat-item p { font-size: 10px; color: var(--texto-gris); text-transform: uppercase; letter-spacing: 1px; } /* Etiqueta en mayúsculas */

        .panel-ancho {                            /* Panel ancho reutilizable */
            background: var(--panel-bg);          /* Fondo translúcido */
            border: 1px solid var(--borde-panel); /* Borde sutil */
            border-radius: 16px;                  /* Esquinas redondeadas */
            padding: 35px 40px;                   /* Espacio interno generoso */
            width: 100%;                          /* Ancho completo */
            max-width: 800px;                     /* Máximo 800px */
            box-shadow: 0 20px 40px rgba(0,0,0,0.6); /* Sombra fuerte */
            backdrop-filter: blur(10px);          /* Difumina fondo detrás */
        } 
        .panel-login {                            /* Panel específico del login */
            background: var(--panel-bg);          /* Fondo translúcido */
            border: 1px solid var(--borde-panel); /* Borde sutil */
            margin-top: 5vh;                      /* Separación superior */
            border-radius: 16px;                  /* Esquinas redondeadas */
            padding: 30px;                        /* Espacio interno */
            width: 100%;                          /* Ancho completo */
            max-width: 400px;                     /* Máximo 400px (más estrecho) */
            box-shadow: 0 20px 40px rgba(0,0,0,0.6); /* Sombra */
            backdrop-filter: blur(10px);          /* Difumina fondo */
        } 

        .grid-botones { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 20px; } /* Dos columnas iguales con separación */

        .card-btn {                               /* Botón grande tipo "card" */
            background: rgba(255,255,255,0.03);   /* Fondo muy tenue */
            border: 1px solid var(--borde-panel); /* Borde sutil */
            border-radius: 12px;                  /* Esquinas redondeadas */
            padding: 14px 15px;                   /* Espacio interno */
            display: flex;                        /* Flex horizontal */
            align-items: center;                  /* Centrado vertical */
            cursor: pointer;                      /* Cursor mano */
            transition: all 0.2s;                 /* Transición de todo */
            text-align: left;                     /* Texto alineado a la izquierda */
        } 
        .card-btn:hover { background: var(--hover-boton); border-color: var(--dorado); transform: translateY(-3px); } /* Hover con elevación */
        .card-btn.dorado { background: var(--hover-boton); border-color: var(--dorado); } /* Variante destacada (dorada) */
        
        .icono-card {                             /* Icono del card */
            background: rgba(255,255,255,0.08);   /* Fondo blanco tenue */
            width: 35px;                          /* Ancho fijo */
            height: 35px;                         /* Alto fijo */
            display: flex;                        /* Flex para centrar */
            align-items: center;                  /* Centrado vertical */
            justify-content: center;              /* Centrado horizontal */
            border-radius: 8px;                   /* Esquinas redondeadas */
            margin-right: 15px;                   /* Separación con el texto */
            font-weight: bold;                    /* Negrita */
        } 
        .card-btn.dorado .icono-card { background: var(--dorado); color: black; } /* Icono dorado en variante destacada */
        .textos-card h4 { font-size: 14px; margin-bottom: 3px; } /* Título del card */
        .textos-card p { font-size: 11px; color: var(--texto-gris); } /* Descripción del card */

        .cabecera-login { text-align: center; margin-bottom: 25px; } /* Cabecera del formulario login */
        .cabecera-login h2 { font-size: 18px; margin-bottom: 5px; }  /* Título del login */
        .cabecera-login p { font-size: 11px; color: var(--texto-gris); } /* Subtítulo gris */

        .grupo-input { margin-bottom: 15px; width: 100%; } /* Contenedor de cada input */
        .grupo-input label { display: flex; justify-content: space-between; font-size: 11px; color: var(--texto-gris); margin-bottom: 5px; } /* Label con espacio entre texto y link */
        .grupo-input label a { color: var(--dorado); text-decoration: none; } /* Link dorado sin subrayado */
        .grupo-input input { width: 100%; padding: 12px 15px; background: rgba(255,255,255,0.03); border: 1px solid var(--borde-panel); border-radius: 8px; color: white; outline: none; transition: 0.2s; } /* Input estilizado */
        .grupo-input input:focus { border-color: var(--dorado); box-shadow: 0 0 10px rgba(229,169,99,0.2); } /* Foco con borde y glow dorado */
        
        .btn-submit { width: 100%; padding: 12px; background: var(--dorado); color: black; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; margin-top: 10px; transition: 0.2s; } /* Botón de envío */
        .btn-submit:hover { transform: scale(1.02); filter: brightness(1.1); } /* Hover con zoom y brillo */

        .lista-demos { display: flex; flex-direction: column; gap: 8px; margin-top: 15px; width: 100%; } /* Lista vertical de cuentas demo */
        .demo-item { display: flex; align-items: center; border: 1px solid var(--borde-panel); padding: 10px 15px; border-radius: 8px; cursor: pointer; transition: background 0.2s; background: rgba(255,255,255,0.01); } /* Cada cuenta demo */
        .demo-item:hover { background-color: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.2); } /* Hover claro */
        
        .avatar { width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: bold; margin-right: 12px; } /* Círculo con inicial */
        .textos-demo h4 { font-size: 12px; margin-bottom: 2px; } /* Nombre del rol */
        .textos-demo p { font-size: 9px; color: var(--texto-gris); } /* Descripción del rol */
        .etiqueta-rol { margin-left: auto; font-size: 9px; padding: 4px 8px; border-radius: 12px; font-weight: bold; } /* Píldora con el rol */

        .rol-admin { background: rgba(229, 169, 99, 0.15); color: var(--color-admin); border: 1px solid var(--color-admin); } /* Píldora admin */
        .rol-almacen { background: rgba(147, 51, 234, 0.15); color: var(--color-almacen); border: 1px solid var(--color-almacen); } /* Píldora almacén */
        .rol-prod { background: rgba(236, 72, 153, 0.15); color: var(--color-prod); border: 1px solid var(--color-prod); } /* Píldora producción */
        .rol-prov { background: rgba(16, 185, 129, 0.15); color: var(--color-prov); border: 1px solid var(--color-prov); } /* Píldora proveedor */

        .btn-volver { background: none; border: none; color: var(--texto-gris); font-size: 11px; margin-top: 20px; cursor: pointer; text-decoration: underline; } /* Link "volver" */
        .btn-volver:hover { color: white; } /* Hover blanco */

        /* =========================================================
           ZONA 8: ESTILOS GENERALES DEL DASHBOARD / CATÁLOGO
           ========================================================= */
        .dash-hero {                              /* Bloque destacado del dashboard */
            background: linear-gradient(135deg, rgba(229, 169, 99, 0.22) 0%, rgba(229, 169, 99, 0.04) 100%); /* Fondo degradado dorado */
            border: 1px solid var(--dorado);      /* Borde dorado */
            border-radius: 16px;                  /* Esquinas redondeadas */
            padding: 30px;                        /* Espacio interno */
            position: relative;                   /* Para posicionar elementos internos */
            width: 100%;                          /* Ancho completo */
            box-shadow: 0 10px 30px rgba(0,0,0,0.3); /* Sombra */
        }
        .dash-hero h2 { font-size: 24px; margin-bottom: 5px; font-weight: 600; } /* Título del hero */
        .dash-hero p { color: var(--texto-gris); font-size: 13px; max-width: 80%; } /* Párrafo gris */
        
        .dash-grid-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 15px; margin-top: 20px;} /* Grid de estadísticas */
        .dash-stat-card { background: var(--panel-bg); border: 1px solid var(--borde-panel); border-radius: 12px; padding: 16px; display: flex; flex-direction: column; transition: transform 0.2s; } /* Tarjeta de estadística */
        .dash-stat-card:hover { transform: translateY(-3px); border-color: rgba(255, 255, 255, 0.25); } /* Hover */
        .dash-stat-card h3 { font-size: 24px; margin-bottom: 2px; } /* Número grande */
        .dash-stat-card p { font-size: 10px; color: var(--texto-gris); text-transform: uppercase; letter-spacing: 1px; } /* Etiqueta en mayúsculas */

        .header-catalogo { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; width: 100%; } /* Cabecera de sección */
        .header-catalogo h2 { font-size: 24px; font-weight: 600; margin-bottom: 5px; } /* Título de la sección */
        .header-catalogo p { font-size: 12px; color: var(--texto-gris); } /* Subtítulo */
        .btn-nuevo { background: var(--dorado); color: black; border: none; padding: 10px 20px; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 12px; transition: 0.2s; } /* Botón "nuevo" dorado */
        .btn-nuevo:hover { filter: brightness(1.1); transform: scale(1.02); } /* Hover */

        .barra-filtros { background: var(--panel-bg); border: 1px solid var(--borde-panel); border-radius: 12px; padding: 15px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; width: 100%; } /* Fila de filtros */
        .barra-filtros input { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; padding: 8px 15px; border-radius: 8px; font-size: 12px; width: 300px; outline: none; } /* Buscador */
        .filtros-botones span { font-size: 12px; color: var(--texto-gris); margin-left: 15px; cursor: pointer; transition: 0.2s; } /* Cada filtro */
        .filtros-botones span:hover { color: white; } /* Hover */
        .filtros-botones span.activo { color: var(--dorado); font-weight: bold; } /* Filtro activo */

        .grid-productos { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; width: 100%; } /* Grid de productos */
        .card-producto { background: var(--panel-bg); border: 1px solid var(--borde-panel); border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; transition: transform 0.2s; } /* Cada producto */
        .card-producto:hover { border-color: rgba(229,169,99,0.3); transform: translateY(-3px); } /* Hover */
        .espacio-imagen { height: 140px; background-color: rgba(255,255,255,0.04); display: flex; align-items: center; justify-content: center; position: relative; } /* Zona de imagen */
        .info-producto { padding: 15px; flex-grow: 1; } /* Info del producto */
        .info-producto h3 { font-size: 16px; margin-bottom: 5px; display: flex; justify-content: space-between; } /* Título del producto */
        .info-producto h3 span { font-size: 11px; color: var(--texto-gris); font-weight: normal; } /* Precio/secundario */
        .info-producto p { font-size: 11px; color: var(--texto-gris); line-height: 1.4; margin-bottom: 15px; } /* Descripción */

        .acciones-producto { display: flex; gap: 8px; } /* Fila de botones */
        .btn-accion { flex: 1; padding: 8px; background: rgba(255,255,255,0.05); border: 1px solid var(--borde-panel); color: white; border-radius: 6px; font-size: 11px; cursor: pointer; transition: 0.2s; } /* Botón de acción */
        .btn-accion:hover { background: rgba(255,255,255,0.1); } /* Hover */
        .btn-accion.principal { background: rgba(229, 169, 99, 0.15); color: var(--dorado); border-color: var(--dorado); } /* Variante principal */
        .btn-accion.principal:hover { background: rgba(229, 169, 99, 0.25); } /* Hover variante principal */

        .card-agregar { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1px dashed rgba(255,255,255,0.2); background: transparent; min-height: 300px; cursor: pointer; transition: 0.2s; } /* Card "agregar producto" */
        .card-agregar:hover { background: rgba(255,255,255,0.02); border-color: var(--dorado); color: var(--dorado); } /* Hover */

        .formulario-producto { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; width: 100%; } /* Grid 2 columnas para el form */
        .caja-subir-imagen { border: 2px dashed rgba(255,255,255,0.2); border-radius: 12px; height: 300px; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; background: rgba(0,0,0,0.2); position: relative; } /* Zona de subir imagen */
