        .tabla-inventario-caja { background: var(--panel-bg); border: 1px solid var(--borde-panel); border-radius: 12px; padding: 20px; width: 100%; overflow-x: auto; box-shadow: 0 10px 30px rgba(0,0,0,0.4); } /* Contenedor de tabla */
