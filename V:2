<!DOCTYPE html> <!-- Le avisamos al navegador que este es un documento HTML5 súper moderno -->
<html lang="es"> <!-- Ponemos el idioma en español pa' que no nos pida traducir la página -->
<head> <!-- Abrimos la cabecera, aquí van las configuraciones que no se ven en pantalla -->
    <meta charset="UTF-8"> <!-- Este código es vital: permite que funcionen las tildes y la letra Ñ -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!-- Hace que la web se adapte al tamaño de los celulares -->
    <title>Villa de Guaduas - Sistema Completo</title> <!-- El nombre que aparece arriba en la pestañita de Google Chrome -->
    
    <!-- Importamos la fuente 'Inter' desde Google Fonts pa' que la letra se vea elegante y moderna -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
    
    <style> 
        /* =========================================================
           ZONA 1: COLORES BASE (Nuestra paleta guardada)
           ========================================================= */
        :root { /* Aquí guardamos los colores en variables pa' no tener que aprendernos los códigos raros */
            --fondo-oscuro: #2a160d; /* Nuestro fondo principal (un café oscuro tipo saddlebrown) */
            --dorado: #d49555; /* Naranja/dorado para botones y textos importantes (tipo peru o chocolate) */
            --panel-bg: rgba(20, 20, 20, 0.95); /* El fondo negro casi transparente de las cajas */
            --borde-panel: rgba(255, 255, 255, 0.08); /* Un borde blanquito súper disimulado */
            --texto-blanco: #ffffff; /* Letra blanca pura para títulos */
            --texto-gris: #a6958a; /* Gris clarito para textos secundarios (no cansa el ojo) */
            --hover-boton: rgba(212, 149, 85, 0.15); /* Color de fondo al pasar el mouse por un botón */
            
            --color-admin: #d49555; /* Color del rol Administrador */
            --color-almacen: #8b5cf6; /* Color del rol Almacén (moradito) */
            --color-prod: #d946ef; /* Color del rol Producción (fucsia) */
            --color-prov: #10b981; /* Color del rol Proveedor (verde) */
            --color-rojo: #ef4444; /* Rojo para alertas críticas */
            --color-amarillo: #eab308; /* Amarillo para alertas medias */
        } 

        * { /* El asterisco afecta a TODO en la página */
            margin: 0; /* Quitamos las márgenes automáticas */
            padding: 0; /* Quitamos los rellenos automáticos */
            box-sizing: border-box; /* Evita que los bordes dañen el tamaño de las cajas */
            font-family: 'Inter', sans-serif; /* Le decimos que use la fuente Inter que descargamos arriba */
        } 

        body { /* Estilos para el cuerpo entero de la página */
            background-color: var(--fondo-oscuro); /* Pintamos el fondo de café oscuro */
            background-image: radial-gradient(circle at 50% 100%, #3e2214 0%, #150a05 100%); /* Efecto de luz difuminada desde abajo */
            color: var(--texto-blanco); /* Toda la letra será blanca por defecto */
            height: 100vh; /* Obliga a que ocupe el 100% de la altura de la pantalla (Viewport Height) */
            display: flex; /* Activamos flexbox para organizar elementos */
            flex-direction: column; /* Apilamos las cosas de arriba hacia abajo (Barra arriba, contenido abajo) */
            overflow: hidden; /* ¡TRUCAZO! Escondemos la barra de desplazamiento fea del navegador general */
        } 

        /* =========================================================
           ZONA 2: BARRA DE NAVEGACIÓN Y EL NUEVO MENÚ CONSTELACIÓN
           ========================================================= */
        .barra-superior { /* La barrita fija que sale arriba al iniciar sesión */
            width: 100%; /* Ocupa todo el ancho */
            background: var(--panel-bg); /* Fondo negro oscuro */
            border-bottom: 1px solid var(--borde-panel); /* Rayita abajo para separar */
            padding: 10px 30px; /* Relleno: 10px arriba/abajo, 30px a los lados */
            display: flex; /* Flexbox para poner cosas a la izquierda y derecha */
            justify-content: space-between; /* Separa los elementos a los extremos */
            align-items: center; /* Centra los elementos verticalmente */
            z-index: 100; /* Asegura que la barra siempre quede por encima de todo lo demás */
        } 
        
        .logo-espacio { display: flex; align-items: center; gap: 15px; } /* Agrupa el logo y el texto de Villa de Guaduas */

        .btn-menu-abrir { /* Botón de "Menú" que abre la constelación */
            background: rgba(255,255,255,0.05); /* Fondo casi transparente */
            border: 1px solid var(--borde-panel); /* Bordecito blanco */
            color: var(--dorado); /* Texto naranja */
            padding: 8px 15px; /* Espacio interno */
            border-radius: 8px; /* Puntas redondas */
            cursor: pointer; /* Sale la manito al pasar el mouse */
            font-weight: bold; /* Letra gordita */
            font-size: 12px; /* Tamaño pequeño */
            margin-right: 15px; /* Lo separa del logo */
        }
        .btn-menu-abrir:hover { background: rgba(212, 149, 85, 0.1); } /* Brilla naranja al pasar el mouse */

        /* EL MODAL OSCURO DEL MENÚ (La "Constelación") */
        .modal-menu-fondo { /* Fondo oscuro que tapa todo al abrir el menú */
            position: fixed; top: 0; left: 0; /* Lo fijamos desde la esquina superior izquierda */
            width: 100vw; height: 100vh; /* Ocupa 100% ancho y 100% alto de la pantalla */
            background: rgba(0,0,0,0.8); /* Fondo negro al 80% de oscuridad */
            display: none; /* Lo mantenemos OCULTO por defecto */
            justify-content: center; align-items: center; /* Centra el menú en toda la pantalla */
            z-index: 999; /* Lo pone por encima del universo entero (999 capas arriba) */
        }
        .modal-menu-fondo.abierto { display: flex; } /* Cuando Javascript le pone la clase "abierto", se muestra (display flex) */

        .caja-constelacion { /* La caja central donde están los íconos */
            background: linear-gradient(135deg, #2a160d, #150a05); /* Degradado café elegante */
            border: 1px solid var(--dorado); /* Borde naranja/dorado */
            border-radius: 16px; padding: 40px; /* Redondo y espacioso */
            width: 90%; max-width: 700px; /* Ancho adaptable */
            text-align: center; position: relative; /* Relativo para poder ubicar la X de cerrar adentro */
        }
        
        .grid-constelacion { /* Cuadrícula que organiza los íconos del menú */
            display: grid; /* Activa la cuadrícula CSS Grid */
            grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); /* Hace que quepan tantos como puedan según el tamaño */
            gap: 20px; margin-top: 30px; /* Separación entre íconos */
        }
        
        .item-menu-circular { display: flex; flex-direction: column; align-items: center; cursor: pointer; transition: 0.2s; } /* Cada botoncito del menú */
        .item-menu-circular:hover { transform: scale(1.1); } /* Efecto de brinquito al pasar el mouse */
        
        .circulo-icono { /* El circulito que contiene el emoji/ícono */
            width: 60px; height: 60px; border-radius: 50%; /* 50% lo vuelve un círculo perfecto */
            background: rgba(255,255,255,0.05); border: 1px solid var(--borde-panel); 
            display: flex; align-items: center; justify-content: center; /* Centra el emoji adentro */
            font-size: 24px; margin-bottom: 10px; 
        }

        /* =========================================================
           ZONA 3: MOTOR DE PANTALLAS Y ÁREA DE SCROLL
           ========================================================= */
        .contenedor-principal { /* Aquí adentro viven todas las pantallas */
            flex-grow: 1; /* Esto hace que ocupe todo el espacio que sobra debajo de la barra superior */
            overflow-y: auto; /* ¡TRUCAZO! Aquí es donde le decimos que SI hay mucho contenido, saque la barra de desplazamiento solo aquí adentro */
            display: flex; flex-direction: column; align-items: center; padding: 30px 20px; /* Lo centramos todo */
        }

        .pantalla { /* Clase base para todas nuestras vistas (Inicio, Dashboard, etc) */
            display: none; /* Las escondemos TODAS para que no se amontonen */
            width: 100%; max-width: 1200px; /* Ancho máximo pa monitores grandes */
            animation: aparecer 0.4s ease-out forwards; /* Las conecta con la animación de aparecer */
            flex-direction: column; align-items: center; /* Centra el contenido internamente */
        } 
        .pantalla.activa { display: flex; } /* MAGIA: La pantalla que tenga esta clase, es la única que se muestra */
        
        @keyframes aparecer { /* Creamos la animación suave */
            from { opacity: 0; transform: translateY(10px); } /* Inicia transparente y 10px abajo */
            to { opacity: 1; transform: translateY(0); } /* Termina visible y en su posición */
        } 

        /* =========================================================
           ZONA 4: ESTILOS DEL INICIO Y LOGIN (LOS TUYOS ORIGINALES)
           ========================================================= */
        .hero-inicio { text-align: center; margin-bottom: 40px; margin-top: 2vh; } /* Textos gigantes de bienvenida */
        .hero-inicio h1 { font-size: 42px; margin-bottom: 10px; } /* Título principal */
        .hero-inicio h1 span { color: var(--dorado); } /* Palabra dorada del título */
        .hero-inicio p { color: var(--texto-gris); font-size: 14px; margin-bottom: 30px; } /* Párrafo debajo del título */
        
        .stats { display: flex; justify-content: center; gap: 50px; } /* Contenedor de los 3 números de la pantalla principal */
        .stat-item { text-align: center; }  /* Cada número individual */
        .stat-item h3 { font-size: 24px; } /* Tamaño del número */
        .stat-item p { font-size: 10px; color: var(--texto-gris); text-transform: uppercase; } /* Texto debajo del número */

        .panel-ancho { /* Cajas negras grandes */
            background: var(--panel-bg); border: 1px solid var(--borde-panel); 
            border-radius: 16px; padding: 30px 40px; width: 100%; max-width: 800px; 
            box-shadow: 0 25px 50px rgba(0,0,0,0.5); /* Sombra pesada para que parezca flotar */
        } 
        .panel-login { /* Cajas negras angostas para los formularios */
            background: var(--panel-bg); border: 1px solid var(--borde-panel); 
            margin-top: 5vh; border-radius: 16px; padding: 30px; width: 100%; 
            max-width: 400px; box-shadow: 0 25px 50px rgba(0,0,0,0.5); 
        } 

        .grid-botones { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 20px; } /* Parte en dos los botones del inicio */
        
        /* IMPERFECCIÓN INTENCIONAL: El padding está en 14px 15px para dar un toque humano/artesanal[cite: 4] */
        .card-btn { background: rgba(255,255,255,0.03); border: 1px solid var(--borde-panel); border-radius: 12px; padding: 14px 15px; display: flex; align-items: center; cursor: pointer; transition: all 0.2s; text-align: left; } /* Botones grandotes del menú principal */
        .card-btn:hover { background: var(--hover-boton); border-color: var(--dorado); transform: translateY(-3px); } /* Se levanta un poquito al hover */
        .card-btn.dorado { background: var(--hover-boton); border-color: var(--dorado); } /* Si ya es dorado, se queda pintado */
        
        .icono-card { background: rgba(255,255,255,0.1); width: 35px; height: 35px; display: flex; align-items: center; justify-content: center; border-radius: 8px; margin-right: 15px; font-weight: bold; } /* El cuadrito del ícono en los botones */
        .card-btn.dorado .icono-card { background: var(--dorado); color: black; } /* Ícono dorado si el botón es dorado */
        .textos-card h4 { font-size: 14px; margin-bottom: 3px; } /* Título del botón */
        .textos-card p { font-size: 11px; color: var(--texto-gris); } /* Subtítulo del botón */

        .cabecera-login { text-align: center; margin-bottom: 25px; } /* Encabezado de los login */
        .cabecera-login h2 { font-size: 18px; margin-bottom: 5px; } 
        .cabecera-login p { font-size: 11px; color: var(--texto-gris); } 

        .grupo-input { margin-bottom: 15px; width: 100%; }  /* Agrupa la pregunta y el campo de texto */
        .grupo-input label { display: flex; justify-content: space-between; font-size: 11px; color: var(--texto-gris); margin-bottom: 5px; } /* El label (ej. "Correo") */
        .grupo-input label a { color: var(--dorado); text-decoration: none; }  /* El enlace de "¿Olvidó contraseña?" */
        .grupo-input input { width: 100%; padding: 12px 15px; background: rgba(255,255,255,0.03); border: 1px solid var(--borde-panel); border-radius: 8px; color: white; outline: none; } /* El campo donde uno escribe */
        .grupo-input input:focus { border-color: var(--dorado); } /* Al dar clic para escribir, se pone naranja el borde */
        
        .btn-submit { width: 100%; padding: 12px; background: var(--dorado); color: black; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; margin-top: 10px; transition: 0.2s; } /* El botón naranja de "Iniciar sesión" */
        .btn-submit:hover { transform: scale(1.02); } /* Se agranda un 2% al pasar el mouse */

        .lista-demos { display: flex; flex-direction: column; gap: 8px; margin-top: 15px; width: 100%; } /* Lista de cuentas de demostración */
        .demo-item { display: flex; align-items: center; border: 1px solid var(--borde-panel); padding: 10px 15px; border-radius: 8px; cursor: pointer; transition: background 0.2s; } /* Cada cuenta clickeable */
        .demo-item:hover { background-color: rgba(255,255,255,0.05); } 
        
        .avatar { width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: bold; margin-right: 12px; } /* El circulito con la inicial (ej. la "A" de admin) */
        .textos-demo h4 { font-size: 12px; margin-bottom: 2px; } /* Nombre del rol demo */
        .textos-demo p { font-size: 9px; color: var(--texto-gris); } 
        .etiqueta-rol { margin-left: auto; font-size: 9px; padding: 4px 8px; border-radius: 12px; font-weight: bold; } /* La pastillita que dice el rol a la derecha */

        /* Clases específicas para dar color a cada rol */
        .rol-admin { background: rgba(212, 149, 85, 0.15); color: var(--color-admin); border: 1px solid var(--color-admin); } 
        .rol-almacen { background: rgba(139, 92, 246, 0.15); color: var(--color-almacen); border: 1px solid var(--color-almacen); } 
        .rol-prod { background: rgba(217, 70, 239, 0.15); color: var(--color-prod); border: 1px solid var(--color-prod); } 
        .rol-prov { background: rgba(16, 185, 129, 0.15); color: var(--color-prov); border: 1px solid var(--color-prov); } 

        .btn-volver { background: none; border: none; color: var(--texto-gris); font-size: 11px; margin-top: 20px; cursor: pointer; text-decoration: underline; } /* Botón chiquito para regresar */
        .btn-volver:hover { color: white; } 


        /* =========================================================
           ZONA 5: ESTILOS DASHBOARD Y CATÁLOGO DE PRODUCTOS
           ========================================================= */
        .dash-hero { /* El banner gigante de bienvenida en el Dashboard */
            background: linear-gradient(135deg, rgba(212, 149, 85, 0.2) 0%, rgba(212, 149, 85, 0.05) 100%); 
            border: 1px solid var(--dorado); border-radius: 16px; padding: 40px 30px; margin-bottom: 20px; position: relative; width: 100%; max-width: 1000px;
        }
        .dash-hero h2 { font-size: 28px; margin-bottom: 5px; font-weight: 600; }
        .dash-hero p { color: var(--texto-gris); font-size: 14px; max-width: 60%; }
        
        .dash-grid-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 15px; margin-bottom: 25px; width: 100%; max-width: 1000px;} /* Cuadrícula de los números rápidos */
        .dash-stat-card { background: var(--panel-bg); border: 1px solid var(--borde-panel); border-radius: 12px; padding: 20px; display: flex; flex-direction: column; transition: transform 0.2s; } /* Las tarjetas con los números */
        .dash-stat-card:hover { transform: translateY(-5px); border-color: rgba(255, 255, 255, 0.2); }
        .dash-stat-card h3 { font-size: 28px; margin-bottom: 5px; } /* El número gigante */
        .dash-stat-card p { font-size: 11px; color: var(--texto-gris); text-transform: uppercase; letter-spacing: 1px; }

        /* Clases utilitarias para pintar textos rápido */
        .texto-naranja { color: var(--dorado); } .texto-verde { color: var(--color-prov); } .texto-rojo { color: var(--color-rojo); } .texto-morado { color: var(--color-almacen); }

        .header-catalogo { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; width: 100%; } /* Encabezado de catálogo */
        .header-catalogo h2 { font-size: 24px; font-weight: 600; margin-bottom: 5px; }
        .header-catalogo p { font-size: 12px; color: var(--texto-gris); }
        .btn-nuevo { background: var(--dorado); color: black; border: none; padding: 10px 20px; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 12px; } /* Botón de crear producto nuevo */

        .barra-filtros { background: var(--panel-bg); border: 1px solid var(--borde-panel); border-radius: 12px; padding: 15px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; width: 100%; } /* La barra oscura donde uno busca */
        .barra-filtros input { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; padding: 8px 15px; border-radius: 8px; font-size: 12px; width: 300px; outline: none; } /* El campo de búsqueda */
        .filtros-botones span { font-size: 12px; color: var(--texto-gris); margin-left: 15px; cursor: pointer; } /* Textos de filtro (Galletas, Postres...) */
        .filtros-botones span.activo { color: var(--dorado); font-weight: bold; } /* El texto que está seleccionado */

        .grid-productos { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; width: 100%; } /* Cuadrícula de las tarjetas de galletas */
        .card-producto { background: var(--panel-bg); border: 1px solid var(--borde-panel); border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; } /* Tarjeta individual de galleta */
        .espacio-imagen { height: 140px; background-color: rgba(255,255,255,0.05); display: flex; align-items: center; justify-content: center; position: relative; } /* El espacio gris donde va la foto */
        .badge-estado { position: absolute; top: 10px; left: 10px; background: rgba(16, 185, 129, 0.2); color: var(--color-prov); border: 1px solid var(--color-prov); font-size: 10px; padding: 3px 8px; border-radius: 12px; font-weight: bold; } /* La pastillita de "Activo" en la esquina de la foto */
        .info-producto { padding: 15px; flex-grow: 1; } /* Los textos de la galleta abajo de la foto */
        .info-producto h3 { font-size: 16px; margin-bottom: 5px; display: flex; justify-content: space-between; }
        .info-producto h3 span { font-size: 11px; color: var(--texto-gris); font-weight: normal; }
        .info-producto p { font-size: 11px; color: var(--texto-gris); line-height: 1.4; margin-bottom: 15px; }
        
        .lista-ingredientes { background: rgba(0,0,0,0.2); border-radius: 8px; padding: 10px; border: 1px solid rgba(255,255,255,0.02); margin-bottom: 15px; } /* Recuadro interno con la receta */
        .lista-ingredientes h5 { font-size: 10px; color: var(--texto-blanco); margin-bottom: 10px; }
        .item-ingrediente { display: flex; justify-content: space-between; font-size: 11px; color: var(--texto-gris); margin-bottom: 5px; border-bottom: 1px dashed rgba(255,255,255,0.05); padding-bottom: 5px; }
        
        .acciones-producto { display: flex; gap: 8px; } /* Botones de producir/editar juntos */
        .btn-accion { flex: 1; padding: 8px; background: rgba(255,255,255,0.05); border: 1px solid var(--borde-panel); color: white; border-radius: 6px; font-size: 11px; cursor: pointer; }
        .btn-accion.principal { background: rgba(212, 149, 85, 0.15); color: var(--dorado); border-color: var(--dorado); }
        .card-agregar { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1px dashed rgba(255,255,255,0.2); background: transparent; min-height: 300px; cursor: pointer; } /* Tarjeta punteada del + */
        .card-agregar:hover { background: rgba(255,255,255,0.02); border-color: var(--dorado); color: var(--dorado); }
        .btn-circulo { width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; font-size: 20px; margin-bottom: 10px; }


        /* =========================================================
           ZONA 6: ESTILOS FORMULARIO NUEVO PRODUCTO Y TABLA INVENTARIO
           ========================================================= */
        .formulario-producto { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; width: 100%; } /* Parte el formulario en 2 columnas */
        
        .caja-subir-imagen { /* El cuadro punteado gigante para subir fotos */
            border: 2px dashed rgba(255,255,255,0.2); border-radius: 12px; height: 300px; 
            display: flex; flex-direction: column; align-items: center; justify-content: center; 
            cursor: pointer; background: rgba(0,0,0,0.2); position: relative; 
        } 
        .caja-subir-imagen input[type="file"] { position: absolute; width: 100%; height: 100%; opacity: 0; cursor: pointer; } /* Input de archivo oculto con opacity 0 para que funcione por debajo de lo visual */
        
        .grupo-input-prod { margin-bottom: 20px; display: flex; flex-direction: column; width: 100%;} /* Grupos del formulario de crear */
        .grupo-input-prod input, .grupo-input-prod select, .grupo-input-prod textarea { padding: 12px; background: rgba(255,255,255,0.03); border: 1px solid var(--borde-panel); border-radius: 8px; color: white; outline: none; } 

        .tabla-inventario-caja { background: var(--panel-bg); border: 1px solid var(--borde-panel); border-radius: 12px; padding: 20px; width: 100%; overflow-x: auto; } /* Caja de la tabla que deja mover a los lados si no cabe */
        .tabla-oscura { width: 100%; border-collapse: collapse; font-size: 12px; text-align: left; } /* La tabla como tal */
        .tabla-oscura th { color: var(--texto-gris); font-size: 10px; padding: 12px 10px; border-bottom: 1px solid var(--borde-panel); } /* Los encabezados de las columnas (ej. "Stock") */
        .tabla-oscura td { padding: 12px 10px; border-bottom: 1px solid rgba(255,255,255,0.02); } /* Cada celda de información */
        .img-miniatura { width: 30px; height: 30px; border-radius: 6px; background: rgba(255,255,255,0.1); display: inline-block; } /* Cuadrito de la foto en la tabla */

    </style> 
</head> 
<body> 

    <div class="galleta"></div> <!-- Nuestra galleta de decoración en el fondo -->

    <!-- =========================================================================================
         BARRA SUPERIOR NAV (Oculta al inicio, se muestra al loguearse)
         ========================================================================================= -->
    <div id="barra-navegacion" class="barra-superior" style="display: none;"> <!-- Lo tenemos en display none pa' que no salga en la de inicio -->
        <div style="display: flex; align-items: center;">
            <button class="btn-menu-abrir" onclick="abrirMenu()">☰ Menú</button> <!-- Botón que dispara la función que abre el menú modal -->
            
            <!-- EL LOGO PRINCIPAL -->
            <div style="width: 40px; height: 40px; background: var(--dorado); border-radius: 8px; display:flex; align-items:center; justify-content:center; color:black; font-weight:bold; margin-right: 15px;">
                <!-- OJO COMPAÑEROS AQUI VA LA IMAGEN 1: LOGO -->
                VG
            </div>
            
            <div>
                <h3 style="font-size: 16px;">Villa de Guaduas</h3> <!-- Nombre de tu empresa -->
                <p style="font-size: 10px; color: var(--texto-gris);">Sistema de Producción</p>
            </div>
        </div>
        
        <div style="display: flex; align-items: center; gap: 10px;">
