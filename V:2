        function previsualizarFoto(inputElement) {
            if (inputElement.files && inputElement.files[0]) { // Revisa que sí hayas subido un archivo
                let lector = new FileReader(); // Crea una herramienta web para leer archivos
                lector.onload = function(evento) { // Cuando termine de leer tu foto...
                    let caja = document.getElementById('area-foto'); // Busca el cuadro punteado
                    let texto = document.getElementById('texto-foto'); // Busca el texto de la camarita
                    
                    caja.style.backgroundImage = "url('" + evento.target.result + "')"; // Pinta la foto como fondo
                    caja.style.backgroundSize = "cover"; // La ajusta pa que quepa bien sin verse estirada
                    caja.style.backgroundPosition = "center"; // La centra
                    texto.style.display = "none"; // Desaparece la camarita y el texto pa que solo se vea la foto
                }
                lector.readAsDataURL(inputElement.files[0]); // Aquí es donde manda a leer el archivo de verdad
            }
        }
