    <!-- =========================================================================================
         LA ZONA DEL JAVASCRIPT: TODAS LAS FUNCIONES 
         ========================================================================================= -->
    <script> 
        /* 1. TUS FUNCIONES ORIGINALES (INTACTAS) */
        
        // Esta función se encarga de apagar todas las pantallas y prender solo la que tú le pidas
        function cambiarPantalla(idPantallaDestino) { 
            let todasLasPantallas = document.querySelectorAll('.pantalla'); // Agarra todas las cajas que sean pantallas
            todasLasPantallas.forEach(function(pantalla) { 
                pantalla.classList.remove('activa'); // Les arranca la clase activa pa esconderlas
            }); 
            document.getElementById(idPantallaDestino).classList.add('activa'); // A la que querías, se la pone
            
            // Un trucazo: Cuando cambias de pantalla, le dice al área de scroll que se vaya hasta la punta de arriba
            document.getElementById('area-scroll').scrollTo(0, 0); 
        } 

        // Esta función es pa las cuentas demo, mete el correo y la clave automáticamente
        function llenarDatos(email, password, idCajitaEmail, idCajitaClave) { 
            document.getElementById(idCajitaEmail).value = email; 
            document.getElementById(idCajitaClave).value = password; 
        } 

        /* 2. FUNCIONES DE SESIÓN */
        
        // Se ejecuta cuando le das al botón de Iniciar Sesión en el formulario
        function simularIngreso() {
            document.getElementById('barra-navegacion').style.display = 'flex'; // Enciende la barra superior pa que se vea
            cambiarPantalla('pantalla-dashboard-admin'); // Te manda pal dashboard de una
        }

        // Se ejecuta cuando le das a la 'X' de la barra superior
        function cerrarSesion() {
            document.getElementById('barra-navegacion').style.display = 'none'; // Vuelve a esconder la barra superior
            cambiarPantalla('pantalla-inicio'); // Te expulsa a la pantalla inicial del sistema
        }

        /* 3. FUNCIONES DEL MENU CONSTELACIÓN */
        
        // Esta prende el fondo negro y muestra los íconos de la constelación
        function abrirMenu() {
            document.getElementById('modal-menu-nav').classList.add('abierto');
        }
        
        // Esta apaga el fondo negro para esconder la constelación
        function cerrarMenu() {
            document.getElementById('modal-menu-nav').classList.remove('abierto');
        }
        
        // Si le das clic a un ícono en la constelación, cambia la pantalla y de paso te cierra el menú pa que no estorbe
        function navegarDesdeMenu(idPantallaDestino) {
            cambiarPantalla(idPantallaDestino);
            cerrarMenu();
        }

        /* 4. FUNCIONES DE LA PANTALLA CREAR PRODUCTO */
        
        // Alerta falsa cuando le das en Guardar
        function guardarProducto() {
            alert("¡Producto guardado exitosamente en el catálogo!");
            cambiarPantalla('pantalla-productos-admin'); // Te devuelve al catálogo pa ver tu nuevo producto
        }

        /* 5. NUEVA FUNCIÓN: AVISO DE FALTA PROGRAMAR (PARA BOTONES PENDIENTES) */
        function avisoFaltaProgramar() {
            alert("⚠️ Falta programar esta función próximamente.");
        }

